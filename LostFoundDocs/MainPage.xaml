<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:comp="clr-namespace:LostFoundDocs.Views.Components"
             xmlns:ui="clr-namespace:LostFoundDocs.UI"
             x:Class="LostFoundDocs.MainPage"
             Title="Galerie">
    <!-- Page TEMPORAIRE (phase A2) : sert à vérifier visuellement les composants. Supprimée en A4. -->
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">
            <comp:LogoMark />
            <Label Text="Galerie de composants" Style="{StaticResource Title}" />
            <Label Text="Page temporaire de la phase A2, supprimée en A4." Style="{StaticResource Subtitle}" />

            <Label Text="Icônes (police Lucide)" Style="{StaticResource SectionTitle}" />
            <HorizontalStackLayout Spacing="14">
                <Label Style="{StaticResource IconLabel}" Text="{x:Static ui:Icons.House}" />
                <Label Style="{StaticResource IconLabel}" Text="{x:Static ui:Icons.ClipboardList}" />
                <Label Style="{StaticResource IconLabel}" Text="{x:Static ui:Icons.MessageSquare}" />
                <Label Style="{StaticResource IconLabel}" Text="{x:Static ui:Icons.User}" />
                <Label Style="{StaticResource IconLabel}" Text="{x:Static ui:Icons.Bell}" />
                <Label Style="{StaticResource IconLabel}" Text="{x:Static ui:Icons.Eye}" />
                <Label Style="{StaticResource IconLabel}" Text="{x:Static ui:Icons.Lock}" />
                <Label Style="{StaticResource IconLabel}" Text="{x:Static ui:Icons.QrCode}" />
            </HorizontalStackLayout>

            <Label Text="Boutons" Style="{StaticResource SectionTitle}" />
            <Button Text="Se connecter" Style="{StaticResource PrimaryButton}" />
            <Button Text="Désactivé" Style="{StaticResource PrimaryButton}" IsEnabled="False" />
            <Button Text="Créer un compte" Style="{StaticResource SecondaryButton}" />
            <Button Text="Action douce" Style="{StaticResource SoftButton}" />
            <Button Text="Mot de passe oublié ?" Style="{StaticResource TextButton}" HorizontalOptions="End" />

            <Label Text="Champs" Style="{StaticResource SectionTitle}" />
            <comp:FormField LabelText="Numéro de téléphone" PrefixText="+237" Placeholder="6 XX XX XX XX" Keyboard="Telephone" />
            <comp:FormField LabelText="Mot de passe" IsPassword="True" HelperText="8 caractères minimum." />
            <comp:FormField LabelText="Numéro du diplôme" IsOptional="True" BadgeText="Recommandé" Placeholder="Ex. 112048213"
                            HelperText="Améliore fortement la correspondance. Masqué partout dans l’application." />
            <comp:FormField LabelText="Date de perte" ErrorText="La date de perte est obligatoire." />

            <Label Text="Encarts" Style="{StaticResource SectionTitle}" />
            <comp:InfoBanner Kind="Info" Title="Information" Message="Ne renseignez que les informations visibles sur le document." />
            <comp:InfoBanner Kind="Success" Title="Succès" Message="Votre signalement a été enregistré." />
            <comp:InfoBanner Kind="Warning" Title="Conseils de sécurité" Message="Rencontrez-vous dans un lieu public, de jour." />
            <comp:InfoBanner Kind="Error" Message="Numéro ou mot de passe incorrect." />
            <comp:InfoBanner Kind="Neutral" Message="Vos informations personnelles sont protégées et ne seront utilisées que pour le fonctionnement du service." />

            <Label Text="Pastilles de statut" Style="{StaticResource SectionTitle}" />
            <comp:StatusBadge Text="Correspondance trouvée" Kind="Success" />
            <comp:StatusBadge Text="Recherche en cours" Kind="Warning" />
            <comp:StatusBadge Text="Restitué" Kind="Success" ShowCheck="True" />
            <comp:StatusBadge Text="Expiré / Archivé" Kind="Neutral" />

            <Label Text="État vide" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}">
                <comp:EmptyState IconGlyph="{x:Static ui:Icons.FileText}" Title="Aucun signalement pour l’instant"
                                 Message="Déclarez un document perdu ou trouvé pour commencer." />
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
