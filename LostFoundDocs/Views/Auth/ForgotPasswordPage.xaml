<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:comp="clr-namespace:LostFoundDocs.Views.Components" xmlns:ui="clr-namespace:LostFoundDocs.UI"
             x:Class="LostFoundDocs.Views.Auth.ForgotPasswordPage"
             Shell.NavBarIsVisible="False" Title="Mot de passe oublié">
    <Grid RowDefinitions="Auto,*">
        <comp:BackHeader Title="Mot de passe oublié" Margin="8,8,8,0" />
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,8,20,20" Spacing="18">
                <Label Text="{Binding Subtitle}" Style="{StaticResource Subtitle}" />
                <comp:InfoBanner Kind="Warning" Title="Simulation" Message="{Binding SimulationNotice}" />

                <VerticalStackLayout Spacing="14" IsVisible="{Binding IsPhoneStep}">
                    <comp:FormField LabelText="Numéro de téléphone" PrefixText="+237" Placeholder="6 XX XX XX XX"
                                    Keyboard="Telephone" MaxLength="17"
                                    Text="{Binding Phone, Mode=TwoWay}" ErrorText="{Binding PhoneError}" />
                    <Button Text="Recevoir le code" Style="{StaticResource PrimaryButton}"
                            Command="{Binding SendCodeCommand}" IsEnabled="{Binding IsNotBusy}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="14" IsVisible="{Binding IsCodeStep}">
                    <comp:FormField LabelText="Code de vérification" Placeholder="123456" Keyboard="Numeric" MaxLength="6"
                                    Text="{Binding Code, Mode=TwoWay}" ErrorText="{Binding CodeError}" />
                    <Button Text="Vérifier le code" Style="{StaticResource PrimaryButton}"
                            Command="{Binding VerifyCodeCommand}" IsEnabled="{Binding IsNotBusy}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="14" IsVisible="{Binding IsPasswordStep}">
                    <comp:FormField LabelText="Nouveau mot de passe" IsPassword="True" HelperText="8 caractères minimum."
                                    Text="{Binding NewPassword, Mode=TwoWay}" ErrorText="{Binding PasswordError}" />
                    <comp:FormField LabelText="Confirmer le mot de passe" IsPassword="True"
                                    Text="{Binding ConfirmPassword, Mode=TwoWay}" ErrorText="{Binding ConfirmError}" />
                    <Button Text="Enregistrer le mot de passe" Style="{StaticResource PrimaryButton}"
                            Command="{Binding ResetCommand}" IsEnabled="{Binding IsNotBusy}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="14" IsVisible="{Binding IsDoneStep}">
                    <comp:InfoBanner Kind="Success" Title="Mot de passe modifié"
                                     Message="Vous pouvez maintenant vous connecter avec votre nouveau mot de passe (simulation)." />
                    <Button Text="Retour à la connexion" Style="{StaticResource PrimaryButton}"
                            Command="{Binding BackToLoginCommand}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
