<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:comp="clr-namespace:LostFoundDocs.Views.Components" x:Class="LostFoundDocs.Views.Notifications.NotificationsPage" x:Name="Root" Shell.NavBarIsVisible="False" Title="Notifications">
    <Grid RowDefinitions="Auto,*,Auto">
        <VerticalStackLayout Padding="16,12" Spacing="8">
<comp:BackHeader Title="Notifications" />
</VerticalStackLayout>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,8,16,28" Spacing="16">
<Button Text="Tout marquer lu" Command="{Binding ReadAllCommand}" Style="{StaticResource TextButton}" IsEnabled="{Binding HasUnread}" />
<comp:EmptyState Title="Aucune notification" Message="Vos nouvelles correspondances et restitutions apparaîtront ici." IsVisible="{Binding IsEmpty}" ActionText="Déclarer un document" ActionCommand="{Binding DeclareCommand}" />
<VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Items}">
<BindableLayout.ItemTemplate>
<DataTemplate>
<Border Style="{StaticResource Card}">
<VerticalStackLayout Spacing="6">
<Label Text="{Binding Title}" Style="{StaticResource CardTitle}" />
<Label Text="{Binding CreatedAt, StringFormat='{0:dd/MM/yyyy HH:mm}'}" Style="{StaticResource Caption}" />
<Label Text="{Binding State}" />
<Button Text="Consulter" Style="{StaticResource TextButton}" Command="{Binding BindingContext.OpenCommand, Source={x:Reference Root}}" CommandParameter="{Binding .}" />
</VerticalStackLayout>
</Border>
</DataTemplate>
</BindableLayout.ItemTemplate>
</VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
