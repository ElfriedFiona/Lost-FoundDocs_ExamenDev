<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:comp="clr-namespace:LostFoundDocs.Views.Components" xmlns:ui="clr-namespace:LostFoundDocs.UI"
             x:Class="LostFoundDocs.Views.Matching.SearchPage"
             Shell.NavBarIsVisible="False" Title="Recherche de correspondance">
    <Grid RowDefinitions="Auto,*,Auto">
        <Label Style="{StaticResource IconLabel}" FontSize="24" TextColor="{StaticResource TextPrimary}" Margin="12,12,0,0"
               HorizontalOptions="Start" WidthRequest="44" HeightRequest="44" Text="{x:Static ui:Icons.X}"
               SemanticProperties.Description="Fermer">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseCommand}" />
            </Label.GestureRecognizers>
        </Label>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,8,20,24" Spacing="16">
                <Grid HorizontalOptions="Center" HeightRequest="120" WidthRequest="120">
                    <Border BackgroundColor="{StaticResource PrimarySoft}" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="60" />
                        </Border.StrokeShape>
                    </Border>
                    <ActivityIndicator IsRunning="{Binding IsRunning}" IsVisible="{Binding IsRunning}" WidthRequest="48" HeightRequest="48"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                    <Border WidthRequest="64" HeightRequest="64" BackgroundColor="{StaticResource Success}" StrokeThickness="0"
                            HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding HasResult}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="32" />
                        </Border.StrokeShape>
                        <Label Style="{StaticResource IconLabel}" FontSize="32" TextColor="{StaticResource White}" Text="{x:Static ui:Icons.Check}" />
                    </Border>
                </Grid>
                <Label Text="Recherche de correspondance" Style="{StaticResource Title}" HorizontalTextAlignment="Center" FontSize="24" />
                <Label Text="Nous comparons votre signalement avec les documents déjà déclarés." Style="{StaticResource Subtitle}" HorizontalTextAlignment="Center" />
                <Label Text="Vous n’avez rien d’autre à faire. Nous continuerons automatiquement la recherche si aucune correspondance n’est trouvée."
                       Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <HorizontalStackLayout Spacing="12">
                            <Label Style="{StaticResource IconLabel}" TextColor="{StaticResource Success}" Text="{x:Static ui:Icons.CircleCheck}" />
                            <Label Text="{Binding Step1Text}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="12">
                            <Label Style="{StaticResource IconLabel}" TextColor="{StaticResource Success}" Text="{x:Static ui:Icons.CircleCheck}" IsVisible="{Binding Step2Done}" />
                            <Label Text="{Binding Step2Text}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="12">
                            <Label Style="{StaticResource IconLabel}" TextColor="{StaticResource Success}" Text="{x:Static ui:Icons.CircleCheck}" IsVisible="{Binding Step3Done}" />
                            <Label Text="{Binding Step3Text}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Label Text="Critères comparés" Style="{StaticResource Caption}" />
                <comp:ChipGroup Items="{Binding Criteria}" />

                <comp:InfoBanner Kind="{Binding ResultKind}" Title="{Binding ResultTitle}" Message="{Binding ResultMessage}"
                                 IsVisible="{Binding HasResult}" />
                <comp:InfoBanner Kind="Neutral" Message="Simulation : la recherche est locale. Le moteur de correspondance réel sera développé avec le backend." />
            </VerticalStackLayout>
        </ScrollView>
        <Button Grid.Row="2" Text="Voir le résultat" Style="{StaticResource PrimaryButton}" Margin="16,8,16,16"
                Command="{Binding ViewResultCommand}" IsEnabled="{Binding HasResult}" />
    </Grid>
</ContentPage>
