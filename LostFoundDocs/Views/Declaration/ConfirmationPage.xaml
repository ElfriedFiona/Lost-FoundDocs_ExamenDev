<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:comp="clr-namespace:LostFoundDocs.Views.Components" x:Class="LostFoundDocs.Views.Declaration.ConfirmationPage" x:Name="Root" Shell.NavBarIsVisible="False" Title="Signalement enregistré">
    <Grid RowDefinitions="Auto,*,Auto">
        <VerticalStackLayout Padding="16,12" Spacing="8">
<comp:BackHeader Title="Signalement enregistré" />
</VerticalStackLayout>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,8,16,28" Spacing="16">
<ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
<comp:InfoBanner Kind="Neutral" Message="Simulation · données fictives, conservées uniquement pendant la session." />
<Border Style="{StaticResource Card}">
<VerticalStackLayout Spacing="8">
<Label Text="{Binding Report.Title}" Style="{StaticResource SectionTitle}" />
<Label Text="{Binding Report.Reference}" Style="{StaticResource Caption}" />
<comp:StatusBadge Status="{Binding Report.Status}" />
<Label Text="{Binding Report.DateLabelLong}" />
<Label Text="{Binding Report.LocationLabel}" />
</VerticalStackLayout>
</Border>
<Button Text="Lancer la recherche" Command="{Binding SearchCommand}" Style="{StaticResource PrimaryButton}"  />
<Button Text="Voir mes signalements" Command="{Binding ListCommand}" Style="{StaticResource SecondaryButton}"  />
            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
