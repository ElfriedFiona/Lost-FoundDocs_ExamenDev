<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:comp="clr-namespace:LostFoundDocs.Views.Components" xmlns:ui="clr-namespace:LostFoundDocs.UI"
             x:Class="LostFoundDocs.Views.Declaration.DeclarationConfirmationPage"
             Shell.NavBarIsVisible="False" Title="Confirmation">
    <Grid RowDefinitions="Auto,*,Auto">
        <Label Style="{StaticResource IconLabel}" FontSize="24" TextColor="{StaticResource TextPrimary}" Margin="12,12,0,0"
               HorizontalOptions="Start" WidthRequest="44" HeightRequest="44" Text="{x:Static ui:Icons.X}"
               SemanticProperties.Description="Fermer">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseCommand}" />
            </Label.GestureRecognizers>
        </Label>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,8,20,24" Spacing="18">
                <Border WidthRequest="88" HeightRequest="88" BackgroundColor="{StaticResource SuccessSoft}" StrokeThickness="0" HorizontalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="44" />
                    </Border.StrokeShape>
                    <Border WidthRequest="56" HeightRequest="56" BackgroundColor="{StaticResource Success}" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="28" />
                        </Border.StrokeShape>
                        <Label Style="{StaticResource IconLabel}" FontSize="28" TextColor="{StaticResource White}" Text="{x:Static ui:Icons.Check}" />
                    </Border>
                </Border>
                <Label Text="{Binding Title}" Style="{StaticResource Title}" HorizontalTextAlignment="Center" />
                <Label Text="{Binding Message}" Style="{StaticResource Subtitle}" HorizontalTextAlignment="Center" />

                <Border Style="{StaticResource Card}" Padding="0">
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="Auto,*" Padding="16,12" ColumnSpacing="16">
                            <Label Text="Référence" Style="{StaticResource Caption}" />
                            <Label Grid.Column="1" Text="{Binding Reference}" HorizontalTextAlignment="End" FontFamily="OpenSansSemibold" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource Border}" />
                        <Grid ColumnDefinitions="Auto,*" Padding="16,12" ColumnSpacing="16">
                            <Label Text="Document" Style="{StaticResource Caption}" />
                            <Label Grid.Column="1" Text="{Binding DocumentTitle}" HorizontalTextAlignment="End" FontFamily="OpenSansSemibold" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" Padding="16,12" ColumnSpacing="16" IsVisible="{Binding HasNumber}">
                            <Label Text="Numéro" Style="{StaticResource Caption}" />
                            <Label Grid.Column="1" Text="{Binding MaskedNumber}" HorizontalTextAlignment="End" FontFamily="OpenSansSemibold" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" Padding="16,12" ColumnSpacing="16">
                            <Label Text="Événement" Style="{StaticResource Caption}" />
                            <Label Grid.Column="1" Text="{Binding EventLabel}" HorizontalTextAlignment="End" FontFamily="OpenSansSemibold" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" Padding="16,12" ColumnSpacing="16">
                            <Label Text="Lieu" Style="{StaticResource Caption}" />
                            <Label Grid.Column="1" Text="{Binding LocationLabel}" HorizontalTextAlignment="End" FontFamily="OpenSansSemibold" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" Padding="16,12,16,14" ColumnSpacing="16">
                            <Label Text="Statut" Style="{StaticResource Caption}" />
                            <Label Grid.Column="1" Text="{Binding StatusLabel}" HorizontalTextAlignment="End" FontFamily="OpenSansSemibold" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <comp:InfoBanner Kind="Neutral" Message="Simulation : le signalement est enregistré localement pour la démonstration. Aucun service réel n’est connecté." />
            </VerticalStackLayout>
        </ScrollView>
        <VerticalStackLayout Grid.Row="2" Padding="16,8,16,16" Spacing="10" BackgroundColor="{StaticResource White}">
            <Button Text="Lancer la recherche" Style="{StaticResource PrimaryButton}" Command="{Binding StartSearchCommand}" />
            <Button Text="Voir mes signalements" Style="{StaticResource SecondaryButton}" Command="{Binding SeeReportsCommand}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
