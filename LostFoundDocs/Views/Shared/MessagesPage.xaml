<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:comp="clr-namespace:LostFoundDocs.Views.Components" xmlns:ui="clr-namespace:LostFoundDocs.UI"
             x:Class="LostFoundDocs.Views.Shared.MessagesPage"
             Shell.NavBarIsVisible="False" Title="Messages">
    <Grid RowDefinitions="Auto,*,Auto">
        <VerticalStackLayout Padding="16,20,16,12" Spacing="2" BackgroundColor="{StaticResource White}">
            <Label Text="Messages" Style="{StaticResource Title}" />
            <Label Text="Échanges sécurisés liés à vos correspondances" Style="{StaticResource Subtitle}" FontSize="14" />
        </VerticalStackLayout>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,12,16,16" Spacing="12">
                <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Items}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="14">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border WidthRequest="48" HeightRequest="48" BackgroundColor="{StaticResource PrimarySoft}" StrokeThickness="0" VerticalOptions="Start">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Label Style="{StaticResource IconLabel}" TextColor="{StaticResource Primary}" Text="{x:Static ui:Icons.MessageSquare}" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="{Binding DocumentTitle}" FontFamily="OpenSansSemibold" FontSize="16" />
                                        <Label Text="{Binding Subtitle}" Style="{StaticResource Caption}" />
                                        <Label Text="{Binding Preview}" FontSize="14" LineBreakMode="TailTruncation" MaxLines="1">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding HasUnread}" Value="True">
                                                    <Setter Property="FontFamily" Value="OpenSansSemibold" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2" Spacing="6" HorizontalOptions="End">
                                        <Label Text="{Binding TimeLabel}" Style="{StaticResource Caption}" FontSize="12" HorizontalTextAlignment="End" />
                                        <Border BackgroundColor="{StaticResource Primary}" StrokeThickness="0" HorizontalOptions="End"
                                                WidthRequest="22" HeightRequest="22" IsVisible="{Binding HasUnread}"
                                                SemanticProperties.Description="Message non lu">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="11" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding UnreadCount}" TextColor="{StaticResource White}" FontSize="12" FontFamily="OpenSansSemibold"
                                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnConversationTapped" />
                                </Border.GestureRecognizers>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Border Style="{StaticResource Card}" IsVisible="{Binding HasNoItems}">
                    <comp:EmptyState IconGlyph="{x:Static ui:Icons.MessageSquare}" Title="Aucune conversation"
                                     Message="Les conversations s’ouvrent après une correspondance, pour organiser la restitution en toute sécurité." />
                </Border>

                <HorizontalStackLayout Spacing="8">
                    <Label Style="{StaticResource IconLabel}" FontSize="18" TextColor="{StaticResource Primary}" Text="{x:Static ui:Icons.Lock}" />
                    <Label Text="Les conversations ne s’ouvrent qu’après une correspondance." Style="{StaticResource Caption}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        <comp:BottomNavBar Grid.Row="2" SelectedTab="Messages" />
    </Grid>
</ContentPage>
