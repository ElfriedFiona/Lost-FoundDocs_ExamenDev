<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:comp="clr-namespace:LostFoundDocs.Views.Components" xmlns:ui="clr-namespace:LostFoundDocs.UI"
             x:Class="LostFoundDocs.Views.Restitution.ReceiptPage"
             Shell.NavBarIsVisible="False" Title="Preuve de restitution">
    <Grid RowDefinitions="Auto,*,Auto">
        <comp:BackHeader Title="Preuve de restitution" Margin="8,8,8,0" />
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,8,16,24" Spacing="14">
                <comp:EmptyState IsVisible="{Binding HasNoReceipt}" IconGlyph="{x:Static ui:Icons.FileText}" Title="Aucun reçu disponible"
                                 Message="Aucune restitution n’a été enregistrée pour ce signalement." />
                <Border Style="{StaticResource Card}" Padding="0" IsVisible="{Binding HasReceipt}">
                    <VerticalStackLayout>
                        <comp:LogoMark Margin="16,14" />
                        <BoxView HeightRequest="1" Color="{StaticResource Border}" />
                        <VerticalStackLayout Padding="16,14" Spacing="6">
                            <Label Text="Reçu numérique de restitution" Style="{StaticResource Caption}" />
                            <Label Text="{Binding Reference}" FontFamily="OpenSansSemibold" FontSize="24" />
                            <comp:StatusBadge Text="Restitution confirmée" Kind="Success" ShowCheck="True" />
                        </VerticalStackLayout>
                        <Grid ColumnDefinitions="Auto,*" Padding="16,8" ColumnSpacing="16">
                            <Label Text="Document" Style="{StaticResource Caption}" />
                            <Label Grid.Column="1" Text="{Binding DocumentTitle}" HorizontalTextAlignment="End" FontFamily="OpenSansSemibold" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" Padding="16,8" ColumnSpacing="16">
                            <Label Text="Date" Style="{StaticResource Caption}" />
                            <Label Grid.Column="1" Text="{Binding DateLabel}" HorizontalTextAlignment="End" FontFamily="OpenSansSemibold" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" Padding="16,8" ColumnSpacing="16">
                            <Label Text="Ville" Style="{StaticResource Caption}" />
                            <Label Grid.Column="1" Text="{Binding City}" HorizontalTextAlignment="End" FontFamily="OpenSansSemibold" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource Border}" Margin="16,6" />
                        <Grid ColumnDefinitions="Auto,*" Padding="16,8" ColumnSpacing="16">
                            <Label Text="Propriétaire" Style="{StaticResource Caption}" />
                            <Label Grid.Column="1" Text="{Binding OwnerName}" HorizontalTextAlignment="End" FontFamily="OpenSansSemibold" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" Padding="16,8" ColumnSpacing="16">
                            <Label Text="Remis par" Style="{StaticResource Caption}" />
                            <Label Grid.Column="1" Text="{Binding HandedByName}" HorizontalTextAlignment="End" FontFamily="OpenSansSemibold" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" Padding="16,8" ColumnSpacing="16">
                            <Label Text="Correspondance" Style="{StaticResource Caption}" />
                            <Label Grid.Column="1" Text="{Binding MatchLabel}" HorizontalTextAlignment="End" FontFamily="OpenSansSemibold" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource Border}" Margin="16,6" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" Padding="16,8">
                            <comp:FakeQrView Payload="{Binding QrPayload}" />
                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Label Text="Code de vérification" Style="{StaticResource Caption}" />
                                <Label Text="{Binding VerificationCode}" FontFamily="OpenSansSemibold" FontSize="20" />
                                <Label Text="Scannez pour vérifier l’authenticité du reçu (non disponible en démonstration)." Style="{StaticResource Caption}" FontSize="12" />
                            </VerticalStackLayout>
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource Border}" Margin="0,8,0,0" />
                        <Label Text="Ce reçu atteste la remise du document à son propriétaire via Lost&amp;Found Docs."
                               Style="{StaticResource Caption}" Padding="16,12" />
                    </VerticalStackLayout>
                </Border>
                <comp:InfoBanner Kind="Warning" Title="Reçu de démonstration" Message="Ce reçu est fictif : le code et le QR ne sont pas vérifiables."
                                 IsVisible="{Binding HasReceipt}" />
            </VerticalStackLayout>
        </ScrollView>
        <Button Grid.Row="2" Text="{Binding SaveText}" Style="{StaticResource PrimaryButton}" Margin="16,8,16,16"
                Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" IsVisible="{Binding HasReceipt}" />
    </Grid>
</ContentPage>
