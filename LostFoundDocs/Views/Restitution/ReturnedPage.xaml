<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:comp="clr-namespace:LostFoundDocs.Views.Components" x:Class="LostFoundDocs.Views.Restitution.ReturnedPage" x:Name="Root" Shell.NavBarIsVisible="False" Title="Document restitué">
    <Grid RowDefinitions="Auto,*,Auto">
        <VerticalStackLayout Padding="16,12" Spacing="8">
<comp:BackHeader Title="Document restitué" />
</VerticalStackLayout>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,8,16,28" Spacing="16">
<ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
<comp:InfoBanner Kind="Neutral" Message="Simulation · données fictives, conservées uniquement pendant la session." />
<Border Style="{StaticResource Card}">
<VerticalStackLayout Spacing="16">
<comp:StatusBadge Text="Restitution confirmée" Kind="Success" ShowCheck="True" />
<Label Text="{Binding Receipt.Summary}" />
<Label Text="{Binding VerificationCode}" FontFamily="OpenSansSemibold" />
<Label Text="Reçu de démonstration – non vérifiable. Aucun QR de vérification réel." Style="{StaticResource Caption}" />
</VerticalStackLayout>
</Border>
<Button Text="Voir la preuve de restitution" Command="{Binding ProofCommand}" Style="{StaticResource PrimaryButton}"  />
<Button Text="Retour à l’accueil" Command="{Binding HomeCommand}" Style="{StaticResource SecondaryButton}"  />
            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
