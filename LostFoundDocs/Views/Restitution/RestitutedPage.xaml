<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:comp="clr-namespace:LostFoundDocs.Views.Components" xmlns:ui="clr-namespace:LostFoundDocs.UI"
             x:Class="LostFoundDocs.Views.Restitution.RestitutedPage"
             Shell.NavBarIsVisible="False" Title="Document restitué">
    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="20,48,20,24" Spacing="18">
                <Border WidthRequest="96" HeightRequest="96" BackgroundColor="{StaticResource SuccessSoft}" StrokeThickness="0" HorizontalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="48" />
                    </Border.StrokeShape>
                    <Border WidthRequest="64" HeightRequest="64" BackgroundColor="{StaticResource Success}" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="32" />
                        </Border.StrokeShape>
                        <Label Style="{StaticResource IconLabel}" FontSize="32" TextColor="{StaticResource White}" Text="{x:Static ui:Icons.Check}" />
                    </Border>
                </Border>
                <Label Text="Document restitué" Style="{StaticResource Title}" HorizontalTextAlignment="Center" />
                <Label Text="La restitution a été enregistrée avec succès." Style="{StaticResource Subtitle}" HorizontalTextAlignment="Center" />
                <Border Style="{StaticResource Card}" Padding="0">
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="Auto,*" Padding="16,12" ColumnSpacing="16">
                            <Label Text="Document" Style="{StaticResource Caption}" />
                            <Label Grid.Column="1" Text="{Binding DocumentTitle}" HorizontalTextAlignment="End" FontFamily="OpenSansSemibold" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource Border}" />
                        <Grid ColumnDefinitions="Auto,*" Padding="16,12" ColumnSpacing="16">
                            <Label Text="Date de restitution" Style="{StaticResource Caption}" />
                            <Label Grid.Column="1" Text="{Binding DateLabel}" HorizontalTextAlignment="End" FontFamily="OpenSansSemibold" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource Border}" />
                        <Grid ColumnDefinitions="Auto,*" Padding="16,12" ColumnSpacing="16">
                            <Label Text="Propriétaire" Style="{StaticResource Caption}" />
                            <Label Grid.Column="1" Text="{Binding OwnerName}" HorizontalTextAlignment="End" FontFamily="OpenSansSemibold" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource Border}" />
                        <Grid ColumnDefinitions="Auto,*" Padding="16,12" ColumnSpacing="16">
                            <Label Text="Remis par" Style="{StaticResource Caption}" />
                            <Label Grid.Column="1" Text="{Binding HandedByName}" HorizontalTextAlignment="End" FontFamily="OpenSansSemibold" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource Border}" />
                        <Grid ColumnDefinitions="Auto,*" Padding="16,12" ColumnSpacing="16">
                            <Label Text="Référence" Style="{StaticResource Caption}" />
                            <Label Grid.Column="1" Text="{Binding Reference}" HorizontalTextAlignment="End" FontFamily="OpenSansSemibold" TextColor="{StaticResource Primary}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
                <Label Text="Merci d’avoir aidé à restituer ce document." Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </ScrollView>
        <VerticalStackLayout Grid.Row="1" Padding="16,8,16,16" Spacing="8" BackgroundColor="{StaticResource White}">
            <Button Text="Voir la preuve de restitution" Style="{StaticResource PrimaryButton}" Command="{Binding ProofCommand}" />
            <Button Text="Retour à l’accueil" Style="{StaticResource TextButton}" Command="{Binding HomeCommand}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
