<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:comp="clr-namespace:LostFoundDocs.Views.Components" xmlns:ui="clr-namespace:LostFoundDocs.UI"
             x:Class="LostFoundDocs.Views.Profile.NotificationPrefsPage"
             Shell.NavBarIsVisible="False" Title="Notifications">
    <Grid RowDefinitions="Auto,*">
        <comp:BackHeader Title="Notifications" Margin="8,8,8,0" />
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,8,16,24" Spacing="14">
                <Label Text="Me prévenir pour" Style="{StaticResource Caption}" />
                <Border Style="{StaticResource Card}" Padding="0">
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="*,Auto" Padding="16,12">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="Correspondances" FontFamily="OpenSansSemibold" FontSize="15" />
                                <Label Text="Un document compatible est détecté." Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding NotifyMatches, Mode=TwoWay}" OnColor="{StaticResource Primary}"
                                    SemanticProperties.Description="Correspondances" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource Border}" />
                        <Grid ColumnDefinitions="*,Auto" Padding="16,12">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="Messages" FontFamily="OpenSansSemibold" FontSize="15" />
                                <Label Text="Une personne répond à votre message." Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding NotifyMessages, Mode=TwoWay}" OnColor="{StaticResource Primary}"
                                    SemanticProperties.Description="Messages" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource Border}" />
                        <Grid ColumnDefinitions="*,Auto" Padding="16,12">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="Restitutions" FontFamily="OpenSansSemibold" FontSize="15" />
                                <Label Text="Une remise de document est enregistrée." Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding NotifyRestitution, Mode=TwoWay}" OnColor="{StaticResource Primary}"
                                    SemanticProperties.Description="Restitutions" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource Border}" />
                        <Grid ColumnDefinitions="*,Auto" Padding="16,12">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="Rappels" FontFamily="OpenSansSemibold" FontSize="15" />
                                <Label Text="Vos signalements restent actifs." Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding NotifyReminders, Mode=TwoWay}" OnColor="{StaticResource Primary}"
                                    SemanticProperties.Description="Rappels" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
                <Label Text="Canal" Style="{StaticResource Caption}" />
                <Border Style="{StaticResource Card}" Padding="0">
                        <Grid ColumnDefinitions="*,Auto" Padding="16,12">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="SMS" FontFamily="OpenSansSemibold" FontSize="15" />
                                <Label Text="En cas de correspondance, au numéro de votre compte." Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding NotifyBySms, Mode=TwoWay}" OnColor="{StaticResource Primary}"
                                    SemanticProperties.Description="SMS" />
                        </Grid>
                </Border>
                <comp:InfoBanner Kind="Neutral" Message="Simulation : ces préférences sont enregistrées localement et n’envoient aucune vraie notification ni aucun SMS." />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
