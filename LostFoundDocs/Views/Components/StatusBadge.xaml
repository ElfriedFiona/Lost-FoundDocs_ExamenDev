<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ui="clr-namespace:LostFoundDocs.UI"
             x:Class="LostFoundDocs.Views.Components.StatusBadge"
             HorizontalOptions="Start">
    <Border x:Name="Pill" StrokeThickness="0" Padding="10,4" HorizontalOptions="Start">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="14" />
        </Border.StrokeShape>
        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
            <BoxView x:Name="Dot" WidthRequest="8" HeightRequest="8" CornerRadius="4" VerticalOptions="Center" />
            <Label x:Name="CheckView" Style="{StaticResource IconLabel}" FontSize="14"
                   Text="{x:Static ui:Icons.Check}" IsVisible="False" VerticalOptions="Center" />
            <Label x:Name="TextView" FontSize="13" FontFamily="OpenSansSemibold" VerticalOptions="Center" />
        </HorizontalStackLayout>
    </Border>
</ContentView>
