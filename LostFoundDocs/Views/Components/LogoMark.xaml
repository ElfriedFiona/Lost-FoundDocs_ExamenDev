<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ui="clr-namespace:LostFoundDocs.UI"
             x:Class="LostFoundDocs.Views.Components.LogoMark"
             HorizontalOptions="Start">
    <HorizontalStackLayout Spacing="12" SemanticProperties.Description="Lost&amp;Found Docs">
        <Border WidthRequest="44" HeightRequest="44" BackgroundColor="{StaticResource Primary}" StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <Label Style="{StaticResource IconLabel}" FontSize="22" TextColor="{StaticResource White}"
                   Text="{x:Static ui:Icons.FileSearch}" />
        </Border>
        <Label FontFamily="OpenSansSemibold" FontSize="20" VerticalOptions="Center">
            <Label.FormattedText>
                <FormattedString>
                    <Span Text="Lost" />
                    <Span Text="&amp;" TextColor="{StaticResource Primary}" />
                    <Span Text="Found Docs" />
                </FormattedString>
            </Label.FormattedText>
        </Label>
    </HorizontalStackLayout>
</ContentView>
