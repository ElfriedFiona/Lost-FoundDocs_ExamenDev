<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LostFoundDocs.Views.Components.InfoBanner"
             x:Name="Root">
    <Border x:Name="Box" StrokeThickness="1" Padding="14" BindingContext="{x:Reference Root}">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="12" />
        </Border.StrokeShape>
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Label x:Name="IconView" Style="{StaticResource IconLabel}" FontSize="20" VerticalOptions="Start" />
            <VerticalStackLayout Grid.Column="1" Spacing="2">
                <Label x:Name="TitleView" Text="{Binding Title}" FontFamily="OpenSansSemibold" FontSize="14"
                       IsVisible="{Binding HasTitle}" />
                <Label x:Name="MessageView" Text="{Binding Message}" FontSize="14"
                       TextColor="{StaticResource TextSecondary}" IsVisible="{Binding HasMessage}" />
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>
