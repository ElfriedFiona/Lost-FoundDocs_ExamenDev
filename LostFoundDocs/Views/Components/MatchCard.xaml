<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:comp="clr-namespace:LostFoundDocs.Views.Components"
             xmlns:ui="clr-namespace:LostFoundDocs.UI"
             x:Class="LostFoundDocs.Views.Components.MatchCard">
    <!-- Les liaisons ciblent MatchViewModelBase (BindingContext hérité de la page). -->
    <VerticalStackLayout Spacing="12">
        <Border Style="{StaticResource Card}" Padding="0">
            <VerticalStackLayout>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="16,14">
                    <Border WidthRequest="48" HeightRequest="48" BackgroundColor="{StaticResource PrimarySoft}" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Label Style="{StaticResource IconLabel}" TextColor="{StaticResource Primary}" Text="{Binding IconGlyph}" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label Text="{Binding Title}" Style="{StaticResource CardTitle}" />
                        <Label Text="{Binding ReferenceLabel}" Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                </Grid>
                <BoxView HeightRequest="1" Color="{StaticResource Border}" />
                <VerticalStackLayout Padding="16,12" Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Score de correspondance" Style="{StaticResource Caption}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding StrengthLabel}" TextColor="{StaticResource SuccessText}"
                               FontFamily="OpenSansSemibold" FontSize="13" />
                    </Grid>
                    <Label Text="{Binding ScoreText}" FontFamily="OpenSansSemibold" FontSize="32"
                           SemanticProperties.Description="{Binding ScoreDescription}" />
                    <ProgressBar Progress="{Binding ScoreFraction}" ProgressColor="{StaticResource Success}" HeightRequest="8" />
                    <Label Text="Indicateur interne de similarité entre les deux signalements, et non une probabilité exacte."
                           Style="{StaticResource Caption}" FontSize="12" />
                </VerticalStackLayout>
                <BoxView HeightRequest="1" Color="{StaticResource Border}" />
                <Grid ColumnDefinitions="Auto,*" Padding="16,10" ColumnSpacing="16">
                    <Label Text="Type de document" Style="{StaticResource Caption}" />
                    <Label Grid.Column="1" Text="{Binding Title}" HorizontalTextAlignment="End" FontFamily="OpenSansSemibold" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*" Padding="16,10" ColumnSpacing="16">
                    <Label Text="Ville" Style="{StaticResource Caption}" />
                    <Label Grid.Column="1" Text="{Binding CityLabel}" HorizontalTextAlignment="End" FontFamily="OpenSansSemibold" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*" Padding="16,10,16,14" ColumnSpacing="16">
                    <Label Text="{Binding DateCaption}" Style="{StaticResource Caption}" />
                    <Label Grid.Column="1" Text="{Binding DateValue}" HorizontalTextAlignment="End" FontFamily="OpenSansSemibold" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <Border Style="{StaticResource Card}" Padding="16,12">
            <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="*,Auto" SemanticProperties.Description="Pourquoi cette correspondance ?"
                      SemanticProperties.Hint="Afficher ou masquer l’explication">
                    <Label Text="Pourquoi cette correspondance ?" FontFamily="OpenSansSemibold" VerticalOptions="Center" />
                    <Label Grid.Column="1" Style="{StaticResource IconLabel}" TextColor="{StaticResource TextPrimary}" Text="{Binding ExplanationGlyph}" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleExplanationCommand}" />
                    </Grid.GestureRecognizers>
                </Grid>
                <VerticalStackLayout Spacing="8" IsVisible="{Binding IsExplanationOpen}">
                    <Label Text="Critères comparés entre les deux signalements :" Style="{StaticResource Caption}" />
                    <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Criteria}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding Name}" VerticalOptions="Center" />
                                    <comp:StatusBadge Grid.Column="1" Text="{Binding StateLabel}" Kind="{Binding Kind}" ShowCheck="{Binding IsMatch}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>

        <HorizontalStackLayout Spacing="8">
            <Label Style="{StaticResource IconLabel}" FontSize="18" TextColor="{StaticResource Primary}" Text="{x:Static ui:Icons.Lock}" />
            <Label Text="Certaines informations sont masquées afin de protéger les données personnelles." Style="{StaticResource Caption}" />
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentView>
