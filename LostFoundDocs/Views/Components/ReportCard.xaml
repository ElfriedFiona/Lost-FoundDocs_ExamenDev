<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:comp="clr-namespace:LostFoundDocs.Views.Components"
             xmlns:ui="clr-namespace:LostFoundDocs.UI"
             x:Class="LostFoundDocs.Views.Components.ReportCard">
    <Border Style="{StaticResource Card}" Padding="14">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped" />
        </Border.GestureRecognizers>
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Border WidthRequest="48" HeightRequest="48" BackgroundColor="{StaticResource PrimarySoft}"
                    StrokeThickness="0" VerticalOptions="Start">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Label x:Name="IconView" Style="{StaticResource IconLabel}" TextColor="{StaticResource Primary}" />
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="4">
                <Label Text="{Binding Title}" Style="{StaticResource CardTitle}" />
                <Label Text="{Binding DateLabel}" Style="{StaticResource Caption}" FontSize="14" />
                <HorizontalStackLayout x:Name="LocationRow" Spacing="6">
                    <Label Style="{StaticResource IconLabel}" FontSize="14" Text="{x:Static ui:Icons.MapPin}" VerticalOptions="Start" />
                    <Label Text="{Binding LocationLabel}" Style="{StaticResource Caption}" FontSize="14" />
                </HorizontalStackLayout>
                <comp:StatusBadge x:Name="Badge" Margin="0,4,0,0" />
            </VerticalStackLayout>
            <Label Grid.Column="2" Style="{StaticResource IconLabel}" FontSize="20" VerticalOptions="Start"
                   Text="{x:Static ui:Icons.ChevronRight}" />
        </Grid>
    </Border>
</ContentView>
