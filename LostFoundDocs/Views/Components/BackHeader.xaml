<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ui="clr-namespace:LostFoundDocs.UI"
             x:Class="LostFoundDocs.Views.Components.BackHeader"
             x:Name="Root">
    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4" BindingContext="{x:Reference Root}" MinimumHeightRequest="48">
        <Label Style="{StaticResource IconLabel}" FontSize="24" TextColor="{StaticResource TextPrimary}"
               Text="{x:Static ui:Icons.ChevronLeft}" WidthRequest="44" HeightRequest="44"
               SemanticProperties.Description="Retour">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnBackTapped" />
            </Label.GestureRecognizers>
        </Label>
        <Label Grid.Column="1" Text="{Binding Title}" FontFamily="OpenSansSemibold" FontSize="17"
               VerticalOptions="Center" SemanticProperties.HeadingLevel="Level1" />
    </Grid>
</ContentView>
