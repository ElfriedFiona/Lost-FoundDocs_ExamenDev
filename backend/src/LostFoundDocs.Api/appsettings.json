{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" } },
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:5080",
  "Security": {
    "ServerSecret": "",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 30,
    "Pbkdf2Iterations": 210000,
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15,
    "OtpMinutes": 10,
    "OtpMaxAttempts": 5,
    "OtpMaxPerHour": 5,
    "AuthRequestsPerMinute": 30,
    "MessagesPerMinute": 20,
    "ExposeOtpInResponse": false,
    "AllowedOrigins": [],
    "TrustForwardedHeaders": false,
    "RequireHttps": false
  },
  "Sms": {
    "Provider": "Log",
    "CountryPrefix": "+237",
    "Url": "",
    "AuthHeaderName": "Authorization",
    "AuthHeaderValue": "",
    "BodyTemplate": "{\"to\":\"{to}\",\"message\":\"{message}\"}"
  },
  "Storage": { "DatabasePath": "data/lostfound.db", "PhotosPath": "data/photos", "MaxPhotoMegabytes": 10, "EnableWal": true },
  "Matching": { "MinScore": 55, "StrongScore": 85, "MaxGapDays": 180, "LostDateToleranceDays": 7 },
  "Restitution": { "UtcOffsetHours": 1, "FirstHour": 7, "LastHour": 19, "MaxDaysAhead": 14 },
  "Public": { "BaseUrl": "http://localhost:5080" },
  "Background": { "Enabled": true }
}
